---
import '../styles/global.css';
import { site, seo } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.title, description = seo.description } = Astro.props;

// per-page canonical/OG URL; the share image is a capture of the hero (public/og.png)
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

// Person schema: feeds knowledge panels / local search for "who is Ryan Moore".
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Halifax', addressRegion: 'NS', addressCountry: 'CA' },
  sameAs: [site.linkedin],
  knowsAbout: ['AI agents', 'System integration', 'Automation', 'PHP', 'Symfony', 'Drupal', 'Web development', 'TypeScript'],
};

const year = new Date().getFullYear(); // build-time: site is fully static
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#f7f5f0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={site.name} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={seo.ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <!-- Hanken Grotesk Variable: the ONE typeface used across the entire site.
       Preloaded to eliminate FOUT on the hero headline — first thing a visitor reads. -->
  <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="nav">
    <div class="wrap nav__in">
      <a href="/" class="brand" aria-label={`${site.name} home`}>
        <span class="brand__name">{site.name}</span>
        <span class="brand__dot" aria-hidden="true"></span>
      </a>
      <nav class="nav__links" aria-label="Primary">
        <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
          <span class="nav__toggle-box" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
        <div class="nav__menu" id="nav-menu">
          <a href="/#work" class="nav__link">Work</a>
          <a href="/#services" class="nav__link">How I help</a>
          <a href="/#background" class="nav__link">Experience</a>
          <a href="/#audit" class="nav__link">Systems audit</a>
        </div>
        <a href="/#contact" class="nav__cta">Get in touch</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer__in">
      <span class="footer__meta">© {year} {site.name} · {site.location} · Est. {site.since}</span>
      <div class="footer__links">
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href="/#work">Work</a>
        <a href="/lab/">Lab</a>
      </div>
    </div>
  </footer>

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    document.querySelectorAll('section').forEach((section) => {
      section.querySelectorAll<HTMLElement>('.reveal').forEach((el, index) => {
        el.style.setProperty('--reveal-delay', `${Math.min(index % 5, 4) * 65}ms`);
        io.observe(el);
      });
    });

    // Nav is transparent over the dark hero, then turns solid once scrolled past it.
    const nav = document.querySelector('.nav');
    const hero = document.querySelector('.hero');
    if (nav && hero) {
      // hero height is only re-measured on resize — reading offsetHeight inside the
      // scroll handler forces a reflow on every scroll event
      let threshold = 0;
      const sync = () => nav.classList.toggle('nav--ghost', window.scrollY < threshold);
      const measure = () => {
        threshold = hero.offsetHeight - 72;
        sync();
      };
      measure();
      window.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', measure);
    }

    // Mobile disclosure menu
    const navToggle = document.querySelector('.nav__toggle');
    const navMenu = document.getElementById('nav-menu');
    if (nav && navToggle && navMenu) {
      const setOpen = (open: boolean) => {
        nav.classList.toggle('nav--open', open);
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      navToggle.addEventListener('click', () =>
        setOpen(!nav.classList.contains('nav--open'))
      );
      navMenu.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => setOpen(false))
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
      document.addEventListener('click', (e) => {
        if (!nav.contains(e.target as Node)) setOpen(false);
      });
    }
  </script>
</body>
</html>
