<!--
  AgentCard — compact live-status element (Inngest-style restraint).
  ONE small self-contained unit: chrome bar + current action + loop motif + meta.
  Replaces the previous dense SVG diagram. No absolutely-positioned sub-elements.
  Stacks cleanly below the headline on mobile via normal flow.
-->
<div
  class="agent-card"
  role="img"
  aria-label="Live agent status: autonomous AI continuously observing, reasoning, acting, and verifying."
>
  <!-- Chrome bar -->
  <div class="agent-card__chrome" aria-hidden="true">
    <span class="agent-card__live">
      <i class="agent-card__led"></i> LIVE
    </span>
    <span class="agent-card__id">RUNTIME / 01</span>
  </div>

  <!-- Body -->
  <div class="agent-card__body" aria-hidden="true">

    <!-- Rotating current action -->
    <div class="agent-card__now">
      <span class="agent-card__now-label">NOW</span>
      <div class="agent-card__stream">
        <span>followed up 2 leads</span>
        <span>updated CRM · 3 records</span>
        <span>scheduled 2 discovery calls</span>
        <span>verified all outcomes</span>
      </div>
    </div>

    <!-- The loop: 4 nodes connected by wires, active cycles via CSS -->
    <div class="agent-card__loop">
      <div class="agent-card__node agent-card__node--0">
        <div class="agent-card__dot"></div>
        <span>OBSERVE</span>
      </div>
      <div class="agent-card__wire"></div>
      <div class="agent-card__node agent-card__node--1">
        <div class="agent-card__dot"></div>
        <span>REASON</span>
      </div>
      <div class="agent-card__wire"></div>
      <div class="agent-card__node agent-card__node--2">
        <div class="agent-card__dot"></div>
        <span>ACT</span>
      </div>
      <div class="agent-card__wire"></div>
      <div class="agent-card__node agent-card__node--3">
        <div class="agent-card__dot"></div>
        <span>VERIFY</span>
      </div>
    </div>

    <!-- Meta line -->
    <div class="agent-card__meta">CYCLE 0482 · CONFIDENCE 97%</div>
  </div>

  <!-- Ambient orange glow (Temporal-style) -->
  <span class="agent-card__glow" aria-hidden="true"></span>
</div>
