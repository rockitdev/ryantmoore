---
import Base from '../layouts/Base.astro';
import IntegrationMarquee from '../components/IntegrationMarquee.astro';
import AgentLoop from '../components/AgentLoop.astro';
import { getCollection } from 'astro:content';
import { site, services, projects, background, stack, testimonials, audit } from '../data/site';
import { TECH_GLYPHS } from '../data/tech-glyphs';

const studies = (await getCollection('caseStudies'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const featured = studies.slice(0, 3);

// only show the testimonials band once a real (non-draft) quote exists
const quotes = testimonials.filter((t) => !t.draft);
---

<Base>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>

  <!-- HERO — Direction B (agent-as-code): oversized type left, annotated code block right -->
  <section class="hero hero--code">
    <canvas class="hero__particles" aria-hidden="true"></canvas>
    <div class="wrap hero__layout">
      <div class="hero__head">
        <span class="kicker reveal">
          Autonomous systems · {site.location}
        </span>

        <h1 class="hero__title serif reveal">
          AI agents that keep the work <em>moving.</em>
        </h1>

        <p class="hero__lede reveal">
          Like a sharp new hire, they follow the work across your tools, handle routine
          decisions, and bring you in when judgment matters. I design the guardrails,
          connect the systems, and make every action visible.
        </p>

        <div class="hero__cta reveal">
          <a href="#audit" class="btn btn--primary">
            See the systems audit <span class="arr">↓</span>
          </a>
          <a href="#work" class="btn btn--ghost">Selected work</a>
        </div>

        <div class="hero__status reveal">
          <span class="led"></span> Runtime online · available for new projects
        </div>
      </div>

      <!-- Direction B visual: annotated agent workflow code block -->
      <div class="hero__network hero__code-wrap reveal" aria-label="Agent workflow code">
        <div class="code-block" role="img" aria-label="TypeScript agent workflow showing observe, reason, act, verify cycle">
          <div class="code-block__chrome">
            <span class="code-block__dots" aria-hidden="true">
              <i></i><i></i><i></i>
            </span>
            <span class="code-block__title">agent/lead-qualify.ts</span>
            <span class="code-block__live"><i class="code-block__led"></i>LIVE</span>
          </div>
          <pre class="code-block__body" aria-hidden="true"><code><span class="tok-kw">async function</span> <span class="tok-fn">runAgent</span>(<span class="tok-param">trigger</span><span class="tok-punct">:</span> <span class="tok-type">HubSpotEvent</span>) {</code>
<code class="code-line--active"><span class="tok-comment">  // 01 OBSERVE — pull context from connected systems</span></code>
<code>  <span class="tok-kw">const</span> <span class="tok-var">lead</span>   <span class="tok-punct">=</span> <span class="tok-kw">await</span> <span class="tok-fn">observe</span>(<span class="tok-param">trigger</span><span class="tok-punct">.</span><span class="tok-prop">contact</span>)<span class="tok-punct">;</span></code>
<code>  <span class="tok-kw">const</span> <span class="tok-var">history</span> <span class="tok-punct">=</span> <span class="tok-kw">await</span> <span class="tok-fn">observe</span>(<span class="tok-param">trigger</span><span class="tok-punct">.</span><span class="tok-prop">interactions</span>)<span class="tok-punct">;</span></code>
<code></code>
<code>  <span class="tok-comment">  // 02 REASON — bounded decision inside policy</span></code>
<code>  <span class="tok-kw">const</span> <span class="tok-var">decision</span> <span class="tok-punct">=</span> <span class="tok-kw">await</span> <span class="tok-fn">reason</span>(<span class="tok-param">lead</span><span class="tok-punct">,</span> <span class="tok-param">history</span><span class="tok-punct">,</span> <span class="tok-type">POLICY</span>)<span class="tok-punct">;</span></code>
<code>  <span class="tok-kw">if</span> (<span class="tok-var">decision</span><span class="tok-punct">.</span><span class="tok-prop">confidence</span> <span class="tok-punct">&lt;</span> <span class="tok-num">0.8</span>) {</code>
<code>    <span class="tok-kw">return</span> <span class="tok-fn">escalate</span>(<span class="tok-var">decision</span>)<span class="tok-punct">;</span>  <span class="tok-comment">// human in loop</span></code>
<code>  }</code>
<code></code>
<code>  <span class="tok-comment">  // 03 ACT — write only what policy permits</span></code>
<code>  <span class="tok-kw">await</span> <span class="tok-fn">act</span>(<span class="tok-punct">()</span> <span class="tok-punct">=&gt;</span> <span class="tok-var">crm</span><span class="tok-punct">.</span><span class="tok-fn">qualify</span>(<span class="tok-var">lead</span><span class="tok-punct">.</span><span class="tok-prop">id</span>))<span class="tok-punct">;</span></code>
<code>  <span class="tok-kw">await</span> <span class="tok-fn">act</span>(<span class="tok-punct">()</span> <span class="tok-punct">=&gt;</span> <span class="tok-var">calendar</span><span class="tok-punct">.</span><span class="tok-fn">book</span>(<span class="tok-var">lead</span><span class="tok-punct">,</span> <span class="tok-type">NEXT_SLOT</span>))<span class="tok-punct">;</span></code>
<code></code>
<code>  <span class="tok-comment">  // 04 VERIFY — confirm outcome, log everything</span></code>
<code>  <span class="tok-kw">const</span> <span class="tok-var">result</span> <span class="tok-punct">=</span> <span class="tok-kw">await</span> <span class="tok-fn">verify</span>(<span class="tok-var">lead</span><span class="tok-punct">.</span><span class="tok-prop">id</span>)<span class="tok-punct">;</span></code>
<code>  <span class="tok-kw">return</span> <span class="tok-fn">log</span>(<span class="tok-punct">{</span> <span class="tok-var">result</span><span class="tok-punct">,</span> <span class="tok-var">cycle</span><span class="tok-punct">:</span> <span class="tok-var">CYCLE</span><span class="tok-punct">++,</span> <span class="tok-var">bounded</span><span class="tok-punct">:</span> <span class="tok-kw">true</span> <span class="tok-punct">}</span>)<span class="tok-punct">;</span></code>
<code>}</code></pre>
          <div class="code-block__status">
            <span class="code-block__badge code-block__badge--ok">CYCLE 0482 · PASS</span>
            <span class="code-block__badge">CONFIDENCE 0.97</span>
            <span class="code-block__badge">4 ACTIONS LOGGED</span>
          </div>
          <ol class="agent-stages" aria-label="How the agent works">
            <li><span class="agent-stages__no">01</span><span class="agent-stages__t"><strong>Observe</strong> pull context from your connected tools</span></li>
            <li><span class="agent-stages__no">02</span><span class="agent-stages__t"><strong>Reason</strong> decide inside the policy you set</span></li>
            <li><span class="agent-stages__no">03</span><span class="agent-stages__t"><strong>Act</strong> write only what it's allowed to</span></li>
            <li><span class="agent-stages__no">04</span><span class="agent-stages__t"><strong>Verify</strong> confirm the outcome, log everything</span></li>
          </ol>
          <p class="agent-stages__human">A person is looped in whenever judgment matters.</p>
        </div>
      </div>

      <div class="hero__proof reveal" aria-label="Agent capabilities">
        <span><strong>25 years</strong> building production systems</span>
        <span><strong>Human judgment</strong> when it matters</span>
        <span><strong>Every action</strong> logged and reviewable</span>
      </div>
    </div>
  </section>

  <IntegrationMarquee />

  <AgentLoop />

  <!-- SELECTED WORK -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section__head reveal">
        <div>
          <span class="kicker">01 · Selected work</span>
          <h2 class="section__title serif">A closer look at <em>a few projects</em>.</h2>
        </div>
      </div>

      <div class="work">
        {featured.map((s, i) => (
          <a class="work__row reveal" href={`/work/${s.id}/`}>
            <span class="work__idx">{String(i + 1).padStart(2, '0')}</span>
            <div class="work__main">
              <div class="work__client">{s.data.client}</div>
              <h3 class="work__name serif">{s.data.title}</h3>
              <p class="work__sum">{s.data.summary}</p>
              <div class="work__tags">
                {s.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
            <div class="work__meta">
              <span class="work__year">{s.data.year}</span>
              <span class="work__go" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
      {studies.length > featured.length && (
        <a class="work__all reveal" href="/work/">
          See all work <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section section--raise" id="projects">
    <div class="wrap">
      <div class="section__head reveal">
        <div>
          <span class="kicker">02 · More work</span>
          <h2 class="section__title serif">Smaller jobs, <em>same care</em>.</h2>
        </div>
      </div>

      <div class="proj-grid">
        {projects.map((p, i) => (
          <article class="proj reveal">
            <div class="proj__top">
              <span class="proj__ix">P/{String(i + 1).padStart(2, '0')}</span>
              <span class="proj__tags">
                {'status' in p && p.status && (
                  <span class="proj__status"><span class="led"></span>{p.status}</span>
                )}
                <span class="proj__kind">{p.kind}</span>
              </span>
            </div>
            <h3 class="proj__name">{p.name}</h3>
            <p class="proj__desc">{p.desc}</p>
            <span class="proj__foot">{p.foot}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="services">
    <div class="wrap">
      <div class="section__head reveal">
        <div>
          <span class="kicker">03 · What I do</span>
          <h2 class="section__title serif">Four kinds of <em>problem I solve</em>.</h2>
        </div>
      </div>

      <div class="svc-grid">
        {services.map((s, i) => (
          <div class="svc reveal">
            <div class="svc__no">{String(i + 1).padStart(2, '0')} /</div>
            <h3 class="svc__title">{s.title}</h3>
            <p class="svc__body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BACKGROUND -->
  <section class="section section--raise" id="background">
    <div class="wrap">
      <div class="section__head reveal">
        <div>
          <span class="kicker">04 · Experience</span>
          <h2 class="section__title serif">Twenty-five years, <em>one focus</em>.</h2>
          <p class="section__lede">
            The same engineer travel platforms and hospitals trust with their hardest
            work. Now building for businesses like yours.
          </p>
        </div>
      </div>

      <div class="tl">
        {background.map((b) => (
          <div class="tl__row reveal">
            <div class="tl__period">{b.period}</div>
            <div>
              <h3 class="tl__role">
                {'link' in b && b.link ? (
                  <a href={b.link} target="_blank" rel="noopener">
                    {b.role} <span class="arr" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  b.role
                )}
              </h3>
              <p class="tl__detail">{b.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="tech reveal">
        <span class="kicker kicker--plain tech__kicker">Technology</span>
        <ul class="stack">
          {stack.map((t) => (
            <li class="stack__item" title={t.name}>
              <svg class="stack__glyph" viewBox={TECH_GLYPHS[t.logo].box} role="img" aria-label={t.name}>
                <path d={TECH_GLYPHS[t.logo].d} />
              </svg>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- AUDIT — fixed-price entry offer for buyers who can't scope a project yet -->
  <section class="section" id="audit">
    <div class="wrap">
      <div class="section__head reveal">
        <div>
          <span class="kicker">05 · Where to start</span>
          <h2 class="section__title serif">Not sure what you need? Start with a <em>systems audit</em>.</h2>
          <p class="section__lede">
            One week, one flat fee. I map how information moves through your business.
            I find where it leaks. Then I hand you a ranked fix list. It's yours whether
            or not we work together after.
          </p>
        </div>
      </div>

      <div class="audit">
        <ol class="audit__steps">
          {audit.steps.map((s, i) => (
            <li class="audit__step reveal">
              <span class="audit__no">{String(i + 1).padStart(2, '0')} /</span>
              <h3 class="audit__title">{s.title}</h3>
              <p class="audit__body">{s.body}</p>
            </li>
          ))}
        </ol>

        <aside class="audit__card reveal">
          <span class="audit__price serif">{audit.price}</span>
          <span class="audit__meta">{audit.priceNote} · {audit.duration}</span>
          <ul class="audit__perks">
            {audit.perks.map((p) => <li class="audit__perk">{p}</li>)}
          </ul>
          <a href="#contact" class="btn btn--primary" data-prefill-audit>
            Book an audit <span class="arr">↗</span>
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS — renders only when a non-draft quote exists in site.ts -->
  {quotes.length > 0 && (
    <section class="section quotes">
      <div class="wrap wrap--narrow">
        {quotes.map((t) => (
          <figure class="quote reveal">
            <div class="quote__mark" aria-hidden="true">&#8220;</div>
            <blockquote class="quote__text serif">{t.quote}</blockquote>
            <figcaption class="quote__cite">
              {t.name}{t.detail && <span class="quote__detail">, {t.detail}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section class="section contact" id="contact">
    <div class="wrap wrap--narrow">
      <span class="kicker kicker--plain reveal">06 · Contact</span>
      <h2 class="contact__title serif reveal" style="margin-top: 1.25rem;">
        Available for the <em>right</em> project.
      </h2>
      <p class="contact__lede reveal">
        A new website. Systems that need to talk. Busywork worth automating. Or a
        tech problem you want sorted. I'm happy to talk it through. I take on
        only a few projects at a time, so each one gets my full attention.
      </p>

      <form id="contact-form" class="cform reveal" novalidate>
        <div class="cform__row">
          <label>
            <span class="lab">Name</span>
            <input type="text" name="name" required autocomplete="name" placeholder="Your name" aria-describedby="err-name" />
            <span class="cform__err" id="err-name" hidden></span>
          </label>
          <label>
            <span class="lab">Email</span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" aria-describedby="err-email" />
            <span class="cform__err" id="err-email" hidden></span>
          </label>
        </div>
        <label>
          <span class="lab">What do you need?</span>
          <select name="interest">
            <option>A project: website, integration, or automation</option>
            <option>The systems audit</option>
            <option>Not sure yet, let's talk</option>
          </select>
        </label>
        <label>
          <span class="lab">Tell me a little about it</span>
          <textarea name="message" required placeholder="What's not talking to what? What keeps getting typed in twice?" aria-describedby="err-message"></textarea>
          <span class="cform__err" id="err-message" hidden></span>
        </label>
        <!-- honeypot: real people never see or fill this -->
        <label class="cform__hp" aria-hidden="true">
          <span class="lab">Company</span>
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
        <button type="submit" class="btn btn--primary cform__send">
          Send it <span class="arr">↗</span>
        </button>
        <p class="cform__status" role="status" aria-live="polite" hidden></p>
      </form>

      <div class="reveal">
        <span class="cform__alt">Forms not your thing? </span>
        <a href={`mailto:${site.email}`} class="contact__mail">{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero layout override: wider right column for code block ── */
  .hero--code .hero__layout {
    grid-template-columns: minmax(22rem, 0.9fr) minmax(28rem, 1.1fr);
  }

  /* ── code-wrap alignment ── */
  .hero__code-wrap {
    min-width: 0;
    display: flex;
    align-items: center;
  }

  /* ── code block ── */
  .code-block {
    width: 100%;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04) inset,
      0 32px 72px rgba(0, 0, 0, 0.60),
      0 0 80px rgba(245, 77, 38, 0.05);
    animation: code-appear 1s 0.32s both cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes code-appear {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .code-block { animation: none; }
  }

  /* chrome bar */
  .code-block__chrome {
    height: 40px;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.025);
  }
  .code-block__dots {
    display: flex;
    gap: 6px;
  }
  .code-block__dots i {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }
  .code-block__title {
    flex: 1;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: rgba(245, 242, 236, 0.40);
    font-style: normal;
  }
  .code-block__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f54d26;
  }
  .code-block__led {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f54d26;
    box-shadow: 0 0 10px #f54d26, 0 0 20px rgba(245, 77, 38, 0.4);
    animation: led-pulse 2s steps(2) infinite;
  }
  @keyframes led-pulse { 50% { opacity: 0.2; } }
  @media (prefers-reduced-motion: reduce) {
    .code-block__led { animation: none; }
  }

  /* code body */
  .code-block__body {
    margin: 0;
    padding: 1.25rem 0 1rem;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: clamp(0.7rem, 1.1vw, 0.82rem);
    line-height: 1.7;
    background: transparent;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
  }
  .code-block__body code {
    display: block;
    padding: 0 1.5rem;
    white-space: pre;
  }

  /* active line highlight */
  .code-line--active {
    background: rgba(245, 77, 38, 0.07);
    border-left: 2px solid #f54d26;
    padding-left: calc(1.5rem - 2px) !important;
    animation: active-line-pulse 4s ease-in-out infinite alternate;
  }
  @keyframes active-line-pulse {
    from { background: rgba(245, 77, 38, 0.06); }
    to   { background: rgba(245, 77, 38, 0.11); }
  }
  @media (prefers-reduced-motion: reduce) {
    .code-line--active { animation: none; }
  }

  /* token colours — near-mono with one signal accent */
  .tok-kw    { color: rgba(245, 242, 236, 0.90); font-weight: 650; }
  .tok-fn    { color: #f54d26; }
  .tok-type  { color: rgba(245, 242, 236, 0.75); }
  .tok-param { color: rgba(245, 242, 236, 0.82); }
  .tok-var   { color: rgba(245, 242, 236, 0.82); }
  .tok-prop  { color: rgba(245, 242, 236, 0.62); }
  .tok-punct { color: rgba(245, 242, 236, 0.35); }
  .tok-num   { color: rgba(245, 242, 236, 0.70); }
  .tok-comment {
    color: rgba(245, 242, 236, 0.32);
    font-style: italic;
  }
  /* active step labels in comments — orange */
  .code-line--active .tok-comment { color: rgba(245, 77, 38, 0.75); font-style: italic; }

  /* status footer */
  .code-block__status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.015);
  }
  .code-block__badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    color: rgba(245, 242, 236, 0.38);
    padding: 0.2rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
  }
  .code-block__badge--ok {
    color: #f54d26;
    border-color: rgba(245, 77, 38, 0.3);
    background: rgba(245, 77, 38, 0.06);
  }

  /* ── responsive ── */
  @media (max-width: 1000px) {
    /* hero layout stacks below 1000px (matches global.css breakpoint) */
    .hero--code .hero__layout {
      grid-template-columns: 1fr;
    }
    .code-block__body {
      font-size: 0.75rem;
    }
  }
  @media (max-width: 640px) {
    .code-block {
      border-radius: 8px;
    }
    .code-block__body {
      font-size: 0.65rem;
      padding-bottom: 0.75rem;
    }
    .code-block__body code {
      padding: 0 1rem;
    }
    .code-line--active {
      padding-left: calc(1rem - 2px) !important;
    }
    .code-block__status {
      padding: 0.6rem 1rem;
    }
  }
</style>

<script>
  /* ============================================================
     STARFIELD — dense Inngest-style particle field.
     3 tiers of stars: dim texture (60%), medium (35%), bright (5%).
     Each star twinkles (slow sinusoidal opacity) and drifts slowly.
     prefers-reduced-motion: renders once, static. Mobile: half count.
     ============================================================ */
  (function initStarfield() {
    const canvas = document.querySelector<HTMLCanvasElement>('.hero__particles');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Star = {
      x: number; y: number; r: number;
      baseO: number; o: number;
      vx: number; vy: number;
      tw: number; tws: number;
      bright: boolean; col: string;
    };
    let stars: Star[] = [];
    let rafId = 0;

    function resize() {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }

    function createStars() {
      const isMobile = window.innerWidth <= 768;
      const count = isMobile ? 140 : 300;
      stars = Array.from({ length: count }, () => {
        const tier = Math.random();
        let r: number, baseO: number, bright = false;
        if (tier < 0.60) {
          // dim background texture
          r = Math.random() * 0.45 + 0.18;
          baseO = Math.random() * 0.16 + 0.06;
        } else if (tier < 0.95) {
          // medium
          r = Math.random() * 0.55 + 0.55;
          baseO = Math.random() * 0.22 + 0.22;
        } else {
          // bright feature stars (a handful)
          r = Math.random() * 0.9 + 1.2;
          baseO = Math.random() * 0.20 + 0.60;
          bright = true;
        }
        return {
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          r,
          baseO,
          o: baseO,
          vx: (Math.random() - 0.5) * 0.05,
          vy: (Math.random() - 0.5) * 0.05,
          tw: Math.random() * Math.PI * 2,
          tws: Math.random() * 0.007 + 0.002,
          bright,
          col: Math.random() < 0.20 ? '245,77,38' : '255,255,255',
        };
      });
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const s of stars) {
        if (!prefersReduced) {
          // Twinkle: slow sinusoidal opacity variation ±28% of base
          s.tw += s.tws;
          s.o = s.baseO * (0.72 + 0.28 * Math.sin(s.tw));
          // Slow drift
          s.x += s.vx;
          s.y += s.vy;
          if (s.x < -2) s.x = canvas.width + 2;
          else if (s.x > canvas.width + 2) s.x = -2;
          if (s.y < -2) s.y = canvas.height + 2;
          else if (s.y > canvas.height + 2) s.y = -2;
        }
        const o = Math.max(0, Math.min(1, s.o));
        // Subtle glow bloom on bright feature stars
        if (s.bright && o > 0.5) {
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r * 3.5, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${s.col},${(o * 0.06).toFixed(3)})`;
          ctx.fill();
        }
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${s.col},${o.toFixed(3)})`;
        ctx.fill();
      }
      if (!prefersReduced) rafId = requestAnimationFrame(draw);
    }

    resize();
    createStars();
    draw(); // always render once (static for prefers-reduced, loop for normal)

    window.addEventListener('resize', () => {
      if (rafId) cancelAnimationFrame(rafId);
      resize();
      createStars();
      draw();
    });
  })();

  /* ============================================================
     SCROLL PROGRESS
     A thin progress signal makes the long-form landing page feel like one journey.
     ============================================================ */
  const progress = document.querySelector<HTMLElement>('.scroll-progress span');
  let progressFrame = 0;
  const syncProgress = () => {
    if (progressFrame) return;
    progressFrame = requestAnimationFrame(() => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress?.style.setProperty('--progress', String(max > 0 ? window.scrollY / max : 0));
      progressFrame = 0;
    });
  };
  syncProgress();
  window.addEventListener('scroll', syncProgress, { passive: true });
  window.addEventListener('resize', syncProgress);

  // Lead intake — posts to the same Make.com webhook Rockit uses; the scenario
  // routes on `source` so these land separately from HVAC trial leads.
  const WEBHOOK = 'https://hook.us2.make.com/8krobh69g2sel56hv5eibni99tlkkipf';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector('.cform__status') as HTMLElement | null;
  const send = form?.querySelector('.cform__send') as HTMLButtonElement | null;

  const control = (name: string) =>
    (form?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null);
  const setErr = (name: string, message: string) => {
    const c = control(name);
    const box = form?.querySelector<HTMLElement>(`#err-${name}`) ?? null;
    if (!c) return;
    if (message) {
      c.setAttribute('aria-invalid', 'true');
      if (box) { box.textContent = message; box.hidden = false; }
    } else {
      c.removeAttribute('aria-invalid');
      if (box) { box.textContent = ''; box.hidden = true; }
    }
  };
  const validateForm = (): boolean => {
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const name = (control('name')?.value ?? '').trim();
    const email = (control('email')?.value ?? '').trim();
    const message = (control('message')?.value ?? '').trim();
    const errs = {
      name: name ? '' : 'Add your name.',
      email: !email ? 'Add your email.' : (emailRe.test(email) ? '' : 'Check that email address.'),
      message: message ? '' : 'Tell me a little about what you need.',
    } as const;
    (['name', 'email', 'message'] as const).forEach((n) => setErr(n, errs[n]));
    const firstBad = (['name', 'email', 'message'] as const).find((n) => errs[n]);
    if (firstBad) { control(firstBad)?.focus(); return false; }
    return true;
  };
  (['name', 'email', 'message'] as const).forEach((n) => {
    control(n)?.addEventListener('input', () => setErr(n, ''));
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!send || !status) return;

    const fd = new FormData(form);
    if ((fd.get('company') as string)?.trim()) return; // honeypot — silently drop bots

    if (!validateForm()) return;

    const original = send.innerHTML;
    send.disabled = true;
    send.textContent = 'Sending…';

    try {
      const res = await fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: (fd.get('name') as string).trim(),
          email: (fd.get('email') as string).trim(),
          interest: fd.get('interest'),
          message: (fd.get('message') as string).trim(),
          source: 'ryantmoore.ca',
          form_source: 'contact',
          submitted_at: new Date().toISOString(),
        }),
      });
      if (!res.ok) throw new Error('webhook failed');

      form.reset();
      send.textContent = 'Got it, talk soon';
      status.textContent = 'Thanks. I read every one of these myself. I will get back to you within a business day.';
      status.classList.add('cform__status--ok');
      status.hidden = false;
    } catch {
      send.disabled = false;
      send.innerHTML = original;
      status.textContent = 'Something went wrong sending that. Email me directly instead.';
      status.classList.remove('cform__status--ok');
      status.hidden = false;
    }
  });

  // "Book an audit" preselects the audit option so the lead arrives labelled.
  document.querySelectorAll('[data-prefill-audit]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const select = form?.querySelector('select[name="interest"]') as HTMLSelectElement | null;
      if (select) select.value = 'The systems audit';
    });
  });
</script>
