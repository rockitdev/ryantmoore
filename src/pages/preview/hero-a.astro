---
/**
 * Preview: Direction A — "Runtime Console" (current live hero)
 * Oversized type + small floating LIVE-runtime agent card + starfield.
 * This is a thin redirect page so QA can screenshot at a stable URL.
 */
import Base from '../../layouts/Base.astro';
import Schematic from '../../components/Schematic.astro';
import IntegrationMarquee from '../../components/IntegrationMarquee.astro';
---

<Base title="Hero Preview — Direction A" description="Hero direction A: runtime console card">
  <div class="preview-label" aria-label="Hero direction indicator">
    <span class="preview-label__badge">Direction A — Runtime Console</span>
    <a href="/preview/hero-b" class="preview-label__link">→ B</a>
    <a href="/preview/hero-c" class="preview-label__link">→ C</a>
  </div>

  <!-- HERO — Direction A (unchanged from live) -->
  <section class="hero">
    <canvas class="hero__particles" aria-hidden="true"></canvas>
    <div class="wrap hero__layout">
      <div class="hero__head">
        <span class="kicker reveal">
          Autonomous systems · Halifax, NS
        </span>

        <h1 class="hero__title serif reveal">
          AI agents that keep the work <em>moving.</em>
        </h1>

        <p class="hero__lede reveal">
          Like a sharp new hire, they follow the work across your tools, handle routine
          decisions, and bring you in when judgment matters. I design the guardrails,
          connect the systems, and make every action visible.
        </p>

        <div class="hero__cta reveal">
          <a href="#contact" class="btn btn--primary">
            Start with a systems audit <span class="arr">↓</span>
          </a>
          <a href="#work" class="btn btn--ghost">Selected work</a>
        </div>

        <div class="hero__status reveal">
          <span class="led"></span> Runtime online · available for new projects
        </div>
      </div>

      <div class="hero__network reveal">
        <Schematic />
      </div>

      <div class="hero__proof reveal" aria-label="Agent capabilities">
        <span><strong>25 years</strong> building production systems</span>
        <span><strong>Human judgment</strong> when it matters</span>
        <span><strong>Every action</strong> logged and reviewable</span>
      </div>
    </div>
  </section>

  <IntegrationMarquee />
</Base>

<style>
  .preview-label {
    position: fixed;
    top: 80px;
    right: 1.5rem;
    z-index: 9000;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(10, 10, 10, 0.9);
    border: 1px solid rgba(245, 77, 38, 0.4);
    border-radius: 8px;
    padding: 0.4rem 0.75rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: rgba(245, 242, 236, 0.7);
    backdrop-filter: blur(12px);
  }
  .preview-label__badge {
    color: #f54d26;
    font-weight: 700;
  }
  .preview-label__link {
    color: rgba(245, 242, 236, 0.5);
    text-decoration: none;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }
  .preview-label__link:hover {
    color: #f54d26;
    background: rgba(245, 77, 38, 0.1);
  }
</style>

<script>
  // Particle field — identical to main hero
  const particleCanvas = document.querySelector<HTMLCanvasElement>('.hero__particles');
  const hero = document.querySelector<HTMLElement>('.hero');
  const particleContext = particleCanvas?.getContext('2d');
  if (particleCanvas && particleContext && hero) {
    type Particle = { x: number; y: number; size: number; speed: number; alpha: number; orange: boolean };
    let width = 0, height = 0, dpr = 1, particles: Particle[] = [], frame = 0, lastPaint = 0;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.matchMedia('(max-width: 640px)').matches;
    const animateParticles = !reducedMotion && !mobile;
    const seeded = (i: number, o: number) => { const v = Math.sin(i * 9283.31 + o * 77.17) * 43758.5453; return v - Math.floor(v); };
    const sizeParticles = () => {
      const rect = hero.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      particleCanvas.width = Math.round(width * dpr);
      particleCanvas.height = Math.round(height * dpr);
      particleContext.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = mobile ? 20 : Math.min(48, Math.max(30, Math.round(width / 30)));
      particles = Array.from({ length: count }, (_, i) => ({
        x: seeded(i, 1) * width, y: seeded(i, 2) * height,
        size: 0.6 + seeded(i, 3) * 1.35, speed: 0.035 + seeded(i, 4) * 0.09,
        alpha: 0.12 + seeded(i, 5) * 0.32, orange: seeded(i, 6) > 0.84,
      }));
      paintParticles(0);
    };
    const paintParticles = (delta: number) => {
      particleContext.clearRect(0, 0, width, height);
      for (const p of particles) {
        if (delta) { p.x += p.speed * delta; p.y -= p.speed * delta * 0.16; if (p.x > width + 4) p.x = -4; if (p.y < -4) p.y = height + 4; }
        particleContext.beginPath(); particleContext.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        particleContext.fillStyle = p.orange ? `rgba(245,77,38,${p.alpha})` : `rgba(245,242,236,${p.alpha})`;
        particleContext.fill();
      }
    };
    const animate = (time: number) => {
      if (time - lastPaint >= 33) { paintParticles(Math.min(time - lastPaint, 50)); lastPaint = time; }
      frame = requestAnimationFrame(animate);
    };
    new ResizeObserver(sizeParticles).observe(hero);
    sizeParticles();
    if (animateParticles) frame = requestAnimationFrame(animate);
    window.addEventListener('pagehide', () => cancelAnimationFrame(frame), { once: true });
  }
  // Nav ghost
  const nav = document.querySelector('.nav');
  const heroEl = document.querySelector('.hero');
  if (nav && heroEl) {
    let threshold = 0;
    const sync = () => nav.classList.toggle('nav--ghost', window.scrollY < threshold);
    const measure = () => { threshold = (heroEl as HTMLElement).offsetHeight - 72; sync(); };
    measure();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', measure);
  }
</script>
