---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';

const studies = (await getCollection('caseStudies'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={`Work · ${site.name}`}
  description="Selected case studies: AI agents, systems integration, and web platforms Ryan Moore has built."
>
  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <div>
          <span class="kicker">Selected work</span>
          <h1 class="section__title serif">Things I've <em>built</em>.</h1>
        </div>
      </div>

      <div class="work">
        {studies.map((s, i) => (
          <a class="work__row" href={`/work/${s.id}/`}>
            <span class="work__idx">{String(i + 1).padStart(2, '0')}</span>
            <div class="work__main">
              <div class="work__client">{s.data.client}</div>
              <h3 class="work__name serif">{s.data.title}</h3>
              <p class="work__sum">{s.data.summary}</p>
              <div class="work__tags">
                {s.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
            <div class="work__meta">
              <span class="work__year">{s.data.year}</span>
              <span class="work__go" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
